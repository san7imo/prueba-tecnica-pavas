{
  "name": "pavas-moto-workshop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API foundation for PAVAS Moto Workshop",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:migrate:test": "NODE_ENV=test node scripts/migrate.js up",
    "db:migrate:reset:test": "NODE_ENV=test node scripts/migrate.js reset",
    "db:seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
