NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pavas_workshop
DB_NAME_TEST=pavas_workshop_test
DB_USER=pavas
DB_PASSWORD=change_me_for_local_development

# Los secretos de autenticación deben ser distintos y tener al menos 32 caracteres aleatorios.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Un origen exacto sin slash/path final; producción exige HTTPS.
FRONTEND_ORIGIN=http://localhost:5173
# Producción exige true. SameSite=none también exige true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Usado sólo por `npm run db:seed:admin`; nunca versionar una contraseña real.
ADMIN_SEED_NAME=Initial Administrator
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=replace_with_a_strong_seed_password
