{
  "info": {
    "_postman_id": "c31a9ef8-21f3-4c1b-a144-9f38d3b33bd5",
    "name": "PAVAS Moto Workshop",
    "description": "Implemented Client, Bike and HITO 4 Work Order API requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "bikeId",
      "value": ""
    },
    {
      "key": "bikePlate",
      "value": ""
    },
    {
      "key": "workOrderId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "toStatus",
      "value": "DIAGNOSTICO"
    }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Perez\",\n  \"phone\": \"3001234567\",\n  \"email\": \"juan.hito2@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/clients",
            "description": "Creates a client and stores its id as clientId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.have.property('id');",
                  "pm.collectionVariables.set('clientId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients?search=Juan",
            "description": "Searches partially across name, phone and email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get client",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('clientId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bikes",
      "item": [
        {
          "name": "Create bike",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('requestPlate', `h2 ${Date.now().toString().slice(-8)}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.have.property('client');",
                  "pm.collectionVariables.set('bikeId', body.data.id);",
                  "pm.collectionVariables.set('bikePlate', body.data.plate);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{requestPlate}}\",\n  \"brand\": \"Yamaha\",\n  \"model\": \"FZ 2.0\",\n  \"cylinder\": 149,\n  \"clientId\": {{clientId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/bikes",
            "description": "Creates a bike for clientId and stores its id and normalized plate."
          }
        },
        {
          "name": "Search bikes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bikes?plate={{bikePlate}}",
            "description": "Searches by a normalized partial plate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get bike",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bikes/{{bikeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data).to.have.property('client');",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('bikeId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Work Orders",
      "item": [
        {
          "name": "Create Work Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": {{bikeId}},\n  \"entryDate\": \"2026-08-24T15:00:00.000Z\",\n  \"faultDescription\": \"Abnormal transmission noise\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders",
            "description": "Creates a RECIBIDA work order with total 0.00 and stores its id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.status).to.eql('RECIBIDA');",
                  "pm.expect(data.total).to.eql('0.00');",
                  "pm.collectionVariables.set('workOrderId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Work Order Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MANO_OBRA\",\n  \"description\": \"General inspection\",\n  \"count\": \"2.00\",\n  \"unitValue\": \"50000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/items",
            "description": "Creates an item transactionally, captures itemId and verifies the server-calculated total."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.workOrderTotal).to.eql('100000.00');",
                  "pm.collectionVariables.set('itemId', data.item.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders",
            "description": "Returns the default first page with metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(body.meta.page).to.eql(1);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders?status=RECIBIDA&plate={{bikePlate}}&page=1&pageSize=20",
            "description": "Combines contractual status and normalized partial-plate filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "pm.expect(body.data[0].status).to.eql('RECIBIDA');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Work Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}",
            "description": "Returns the work order with Bike, Client and items."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data).to.have.property('items');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Work Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStatus\": \"{{toStatus}}\",\n  \"note\": \"Phase 1 accepts this note without persisting history\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/status",
            "description": "Updates status transactionally. Examples: DIAGNOSTICO, EN_PROCESO, LISTA, ENTREGADA and CANCELADA. Set toStatus to a target valid from the order's current state."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data.status).to.eql(pm.collectionVariables.get('toStatus'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Work Order Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/work-orders/items/{{itemId}}",
            "description": "Deletes the captured item and verifies that the final total returns to zero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.deletedItemId)).to.eql(String(pm.collectionVariables.get('itemId')));",
                  "pm.expect(data.workOrderTotal).to.eql('0.00');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
