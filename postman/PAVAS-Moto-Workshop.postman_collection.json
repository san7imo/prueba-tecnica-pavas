  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Comprobar API",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Comprueba que Express responde antes de iniciar el recorrido; no valida por sí solo la conexión a MySQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql('ok');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autentica el ADMIN creado por seed. Postman conserva la cookie HttpOnly de refresh en su cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.user).not.to.have.property('passwordHash');",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consultar usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Devuelve el usuario activo representado por el access token actual."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).not.to.have.property('passwordHash');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Renovar sesión",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Usa y rota la cookie HttpOnly de refresh conservada por Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.variables.set('requestUserEmail', `postman.mechanic.${suffix}@example.test`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).not.to.have.property('passwordHash');",
                  "pm.collectionVariables.set('managedUserId', body.data.id);",
                  "pm.collectionVariables.set('mechanicId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Mechanic\",\n  \"email\": \"{{requestUserEmail}}\",\n  \"password\": \"Replace-this-password-123\",\n  \"role\": \"MECANICO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registro exclusivo de ADMIN. Guarda el ID para las requests de Usuarios; reemplace la contraseña de ejemplo localmente."
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revoca la sesión de refresh actual y limpia su cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.loggedOut).to.eql(true);",
                  "pm.collectionVariables.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users",
            "description": "Listado seguro de usuarios exclusivo de ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(JSON.stringify(body)).not.to.include('passwordHash');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cambiar rol de usuario",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"{{managedUserRole}}\",\n  \"reason\": \"{{mutationReason}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{managedUserId}}/role",
            "description": "Actualización de rol exclusiva de ADMIN. Exige razón y protege último ADMIN/mecánicos con órdenes abiertas. Use ADMIN o MECANICO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.role).to.eql(pm.collectionVariables.get('managedUserRole'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cambiar estado activo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": {{managedUserActive}},\n  \"reason\": \"{{mutationReason}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{managedUserId}}/active",
            "description": "Activación o desactivación exclusiva de ADMIN mediante un boolean JSON real y razón obligatoria; no permite orfanar trabajo ni perder el último ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.active)).to.eql(pm.collectionVariables.get('managedUserActive'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Crear cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.variables.set('requestClientDocumentNumber', `10${suffix.slice(-8)}`);",
                  "pm.variables.set('requestClientPhone', `30${suffix.slice(-10)}`);",
                  "pm.variables.set('requestClientEmail', `postman.client.${suffix}@example.test`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.have.property('id');",
                  "pm.expect(body.data.documentNumber).to.eql(pm.variables.get('requestClientDocumentNumber'));",
                  "pm.collectionVariables.set('clientId', body.data.id);",
                  "pm.collectionVariables.set('clientDocumentNumber', body.data.documentNumber);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentNumber\": \"{{requestClientDocumentNumber}}\",\n  \"name\": \"Cliente Postman\",\n  \"phone\": \"{{requestClientPhone}}\",\n  \"email\": \"{{requestClientEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/clients",
            "description": "Crea un cliente con cédula única y guarda su ID y cédula para el recorrido."
          }
        },
        {
          "name": "Buscar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients?documentNumber={{clientDocumentNumber}}&lifecycle={{lifecycle}}&page=1&pageSize=20",
            "description": "Busca por igualdad exacta de cédula, filtra active/deleted/all y devuelve metadata paginada. search conserva nombre, teléfono o email como alternativas; deleted/all requieren ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(body.meta.page).to.eql(1);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consultar cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('clientId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Postman actualizado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/clients/{{clientId}}",
            "description": "Actualiza campos allowlisted. Phone/email aplican la política de riesgo duplicado."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().data.name).to.eql('Cliente Postman actualizado');"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Archivar cliente",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"{{mutationReason}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/clients/{{clientId}}",
            "description": "Soft delete exclusivo de ADMIN. Requiere razón y sólo funciona cuando el cliente no tiene motocicletas activas."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().data.lifecycle).to.eql('deleted');"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Restaurar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"{{mutationReason}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/clients/{{clientId}}/restore",
            "description": "Restaura el cliente sin restaurar motos; un conflicto de contacto activo puede exigir confirmDuplicate y duplicateReason."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().data.lifecycle).to.eql('active');"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "Motocicletas",
      "item": [
        {
          "name": "Crear motocicleta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('requestPlate', `h2 ${Date.now().toString().slice(-8)}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
