            "description": "Busca por una placa parcial normalizada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consultar motocicleta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bikes/{{bikeId}}"
