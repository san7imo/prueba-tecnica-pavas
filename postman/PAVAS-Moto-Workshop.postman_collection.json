            "description": "Activación o desactivación exclusiva de ADMIN mediante un boolean JSON real."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.active)).to.eql(pm.collectionVariables.get('managedUserActive'));"
                ],
                "type": "text/javascript"
