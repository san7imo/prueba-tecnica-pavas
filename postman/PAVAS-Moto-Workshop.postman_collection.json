    {
      "name": "Órdenes de trabajo",
      "item": [
        {
          "name": "Crear orden de trabajo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": {{bikeId}},\n  \"entryDate\": \"2026-08-24T15:00:00.000Z\",\n  \"faultDescription\": \"Abnormal transmission noise\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders",
            "description": "Crea una orden RECIBIDA con total 0.00, registra atómicamente el evento inicial y guarda su ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.status).to.eql('RECIBIDA');",
                  "pm.expect(data.total).to.eql('0.00');",
                  "pm.collectionVariables.set('workOrderId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Asignar responsable",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mechanicId\": {{mechanicId}},\n  \"reason\": \"{{assignmentReason}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/assignment",
            "description": "Asigna o reasigna un MECANICO activo. Use null para dejar sin responsable; reasignar/desasignar exige razón."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "const data = pm.response.json().data;",
                "pm.expect(String(data.assignedMechanicId)).to.eql(String(pm.collectionVariables.get('mechanicId')));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Agregar ítem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MANO_OBRA\",\n  \"description\": \"General inspection\",\n  \"count\": \"2.00\",\n  \"unitValue\": \"50000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/items",
            "description": "Crea un ítem en transacción, captura itemId y verifica el total calculado por el servidor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.workOrderTotal).to.eql('100000.00');",
                  "pm.collectionVariables.set('itemId', data.item.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar órdenes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders?clientDocumentNumber={{clientDocumentNumber}}&page=1&pageSize=20",
            "description": "Devuelve las órdenes del cliente localizado por cédula exacta con metadata paginada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(body.meta.page).to.eql(1);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar órdenes sin asignar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders?scope=unassigned&page=1&pageSize=20",
            "description": "Cola administrativa de trabajo abierto o histórico sin responsable. Con token MECANICO este scope responde 403."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().data).to.be.an('array');"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Filtrar órdenes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders?status=RECIBIDA&plate={{bikePlate}}&page=1&pageSize=20",
            "description": "Combina estado y placa por igualdad exacta normalizada; también admite bikeId, scope y assignedMechanicId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "pm.expect(body.data[0].status).to.eql('RECIBIDA');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Consultar orden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}",
            "description": "Devuelve la orden con Bike, Client e ítems."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data).to.have.property('items');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStatus\": \"{{toStatus}}\",\n  \"note\": \"Motivo operativo de la transición o regresión\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/status",
            "description": "Actualiza estado, history y audit en una transacción. Configure toStatus con una arista válida; las regresiones requieren note."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data.status).to.eql(pm.collectionVariables.get('toStatus'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reabrir por garantía o misma falla",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"{{reopenType}}\",\n  \"reason\": \"{{reopenReason}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/reopen",
            "description": "Sólo ADMIN y sólo desde ENTREGADA. Use WARRANTY o SAME_ISSUE; una falla distinta requiere una nueva orden."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().data.status).to.eql('DIAGNOSTICO');"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Consultar historial",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/history?page=1&pageSize=20",
            "description": "Devuelve historial inmutable y seguro, del más nuevo al más antiguo, con paginación. ADMIN y MECANICO pueden consultarlo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "pm.expect(body.meta.page).to.eql(1);",
                  "pm.expect(body.meta.pageSize).to.eql(20);",
                  "pm.expect(body.data[0]).to.have.property('changedBy');",
                  "pm.expect(body.data[0].changedBy).not.to.have.property('email');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Eliminar ítem",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/work-orders/items/{{itemId}}",
            "description": "Elimina el ítem capturado y verifica que el total final vuelva a cero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.deletedItemId)).to.eql(String(pm.collectionVariables.get('itemId')));",
                  "pm.expect(data.workOrderTotal).to.eql('0.00');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auditoría",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/audit-events?entityType=WORK_ORDER&page=1&pageSize=20",
            "description": "Lectura append-only exclusiva de ADMIN. Admite entityType, entityId, action, actorUserId, dateFrom y dateTo."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.expect(body.data).to.be.an('array');",
                "pm.expect(body.meta.page).to.eql(1);",
                "if (body.data.length > 0) pm.collectionVariables.set('auditEventId', body.data[0].id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Consultar evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/audit-events/{{auditEventId}}",
            "description": "Muestra actor, razón y snapshots/metadata allowlisted. Ejecute primero Listar eventos para capturar auditEventId."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('auditEventId')));",
                "pm.expect(JSON.stringify(body)).not.to.include('passwordHash');"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    }
  ]
}
