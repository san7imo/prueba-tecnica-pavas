{
  "info": {
    "_postman_id": "c31a9ef8-21f3-4c1b-a144-9f38d3b33bd5",
    "name": "PAVAS Moto Workshop",
    "description": "HITO 8 Auth, Users and protected Client, Bike and Work Order API requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "managedUserId",
      "value": ""
    },
    {
      "key": "managedUserRole",
      "value": "ADMIN"
    },
    {
      "key": "managedUserActive",
      "value": "false"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "bikeId",
      "value": ""
    },
    {
      "key": "bikePlate",
      "value": ""
    },
    {
      "key": "workOrderId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "toStatus",
      "value": "DIAGNOSTICO"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Authenticates the seeded ADMIN. Postman stores the HttpOnly refresh cookie in its cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.user).not.to.have.property('passwordHash');",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the active user represented by the current access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).not.to.have.property('passwordHash');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Uses and rotates the HttpOnly refresh cookie maintained by Postman's cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Mechanic\",\n  \"email\": \"postman.mechanic@example.test\",\n  \"password\": \"Replace-this-password-123\",\n  \"role\": \"MECANICO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "ADMIN-only registration. Stores the created id for Users requests; replace the example password locally."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).not.to.have.property('passwordHash');",
                  "pm.collectionVariables.set('managedUserId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revokes the current refresh session and clears its cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.loggedOut).to.eql(true);",
                  "pm.collectionVariables.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users",
            "description": "ADMIN-only safe user listing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(JSON.stringify(body)).not.to.include('passwordHash');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Change User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"{{managedUserRole}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{managedUserId}}/role",
            "description": "ADMIN-only role update. Use ADMIN or MECANICO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.role).to.eql(pm.collectionVariables.get('managedUserRole'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Change User Active",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": {{managedUserActive}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{managedUserId}}/active",
            "description": "ADMIN-only activation/deactivation using a real JSON boolean."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.active)).to.eql(pm.collectionVariables.get('managedUserActive'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Perez\",\n  \"phone\": \"3001234567\",\n  \"email\": \"juan.hito2@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/clients",
            "description": "Creates a client and stores its id as clientId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.have.property('id');",
                  "pm.collectionVariables.set('clientId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients?search=Juan",
            "description": "Searches partially across name, phone and email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get client",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.collectionVariables.get('clientId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bikes",
      "item": [
        {
          "name": "Create bike",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('requestPlate', `h2 ${Date.now().toString().slice(-8)}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.have.property('client');",
                  "pm.collectionVariables.set('bikeId', body.data.id);",
                  "pm.collectionVariables.set('bikePlate', body.data.plate);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"{{requestPlate}}\",\n  \"brand\": \"Yamaha\",\n  \"model\": \"FZ 2.0\",\n  \"cylinder\": 149,\n  \"clientId\": {{clientId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/bikes",
            "description": "Creates a bike for clientId and stores its id and normalized plate."
          }
        },
        {
          "name": "Search bikes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bikes?plate={{bikePlate}}",
            "description": "Searches by a normalized partial plate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get bike",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bikes/{{bikeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data).to.have.property('client');",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('bikeId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Work Orders",
      "item": [
        {
          "name": "Create Work Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": {{bikeId}},\n  \"entryDate\": \"2026-08-24T15:00:00.000Z\",\n  \"faultDescription\": \"Abnormal transmission noise\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders",
            "description": "Creates a RECIBIDA work order with total 0.00 and stores its id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.status).to.eql('RECIBIDA');",
                  "pm.expect(data.total).to.eql('0.00');",
                  "pm.collectionVariables.set('workOrderId', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Work Order Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MANO_OBRA\",\n  \"description\": \"General inspection\",\n  \"count\": \"2.00\",\n  \"unitValue\": \"50000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/items",
            "description": "Creates an item transactionally, captures itemId and verifies the server-calculated total."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.workOrderTotal).to.eql('100000.00');",
                  "pm.collectionVariables.set('itemId', data.item.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders",
            "description": "Returns the default first page with metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "pm.expect(body.meta.page).to.eql(1);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders?status=RECIBIDA&plate={{bikePlate}}&page=1&pageSize=20",
            "description": "Combines contractual status and normalized partial-plate filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "pm.expect(body.data[0].status).to.eql('RECIBIDA');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Work Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}",
            "description": "Returns the work order with Bike, Client and items."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data).to.have.property('items');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Work Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStatus\": \"{{toStatus}}\",\n  \"note\": \"Phase 1 accepts this note without persisting history\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/work-orders/{{workOrderId}}/status",
            "description": "Updates status transactionally. Examples: DIAGNOSTICO, EN_PROCESO, LISTA, ENTREGADA and CANCELADA. Set toStatus to a target valid from the order's current state."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('workOrderId')));",
                  "pm.expect(data.status).to.eql(pm.collectionVariables.get('toStatus'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Work Order Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/work-orders/items/{{itemId}}",
            "description": "Deletes the captured item and verifies that the final total returns to zero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(String(data.deletedItemId)).to.eql(String(pm.collectionVariables.get('itemId')));",
                  "pm.expect(data.workOrderTotal).to.eql('0.00');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
